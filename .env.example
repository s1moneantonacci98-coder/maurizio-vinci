# =============================================================================
# Studio Maurizio Vinci — Portale Studio
# Variabili d'ambiente. Copia questo file in .env.local e compila i valori
# reali (mai committare .env.local: e' gia' escluso da .gitignore).
# =============================================================================

# URL del progetto Supabase condiviso (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chiave pubblica anonima (Project Settings -> API -> anon public).
# Usata lato client e nei Server Components: rispetta sempre la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chiave service_role (Project Settings -> API -> service_role secret).
# SOLO lato server (Server Actions, route handler admin): bypassa la RLS.
# NON esporre mai al client, NON prefissare con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
